# Copy this file to .env.local for local development, and set the same
# values in Vercel → Project Settings → Environment Variables for deploys.
#
# Get these from your Supabase project: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret — DO NOT prefix with NEXT_PUBLIC_, never expose to the
# browser. Powers admin-only account management (create/edit/delete sales
# rep logins) in app/api/admin/**. Get it from Settings -> API -> "service_role".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Server-only secret — DO NOT prefix with NEXT_PUBLIC_, never expose to the
# browser. Powers AI Brain (/assistant, app/api/assistant/**). Get it
# from https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
